{
  "name": "escape-game-builder-cinematics",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "api": "node server/index.js",
    "dev": "node scripts/dev-with-api.mjs",
    "dev:ui": "vite",
    "build": "vite build && node scripts/generate-seo-files.mjs",
    "check": "npm run typecheck && node scripts/check-release.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:rpg3d:smoke": "playwright test tests/e2e/rpg3d-smoke.spec.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node server/index.js"
  },
  "dependencies": {
    "@gltf-transform/cli": "4.3.0",
    "@imgly/background-removal": "^1.7.0",
    "@supabase/supabase-js": "^2.104.0",
    "jszip": "^3.10.1",
    "lucide-react": "^1.9.0",
    "onnxruntime-web": "^1.21.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.184.0"
  },
  "overrides": {
    "protobufjs": "7.6.2",
    "tmp": "0.2.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^6.0.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.12",
    "vitest": "^4.1.5"
  }
}
